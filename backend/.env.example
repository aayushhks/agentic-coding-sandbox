# application
APP_NAME=agentic-coding-sandbox
ENVIRONMENT=development
LOG_LEVEL=INFO

# llm provider: "groq" for real runs, "mock" for tests and local development
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# database, wired in from m5 onward
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_sandbox

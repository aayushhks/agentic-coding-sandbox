# Base origin of the API. Leave empty for local dev (Vite proxies /api to :8000) and for the
# single-process Docker deploy (FastAPI serves the SPA and API together). Set it when the
# dashboard is hosted separately from the API:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
# On a static host with no API at all (what vercel.json builds), read the committed snapshots:
# VITE_STATIC_DATA=true

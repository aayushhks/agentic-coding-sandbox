# Base origin of the API. Leave empty for local dev (Vite proxies /api to :8000) and for the
# single-process Docker deploy (FastAPI serves the SPA and API together). Set it when the
# dashboard is hosted separately from the API, e.g. on Vercel pointing at a Railway backend:
# VITE_API_BASE_URL=https://your-backend.up.railway.app
VITE_API_BASE_URL=

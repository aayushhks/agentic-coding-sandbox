# keep the build context small and the image clean
.git/
**/__pycache__/
**/*.py[cod]

# python envs/caches
backend/.venv/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/

# node (rebuilt inside the image)
frontend/node_modules/
frontend/dist/

# generated eval artifacts and local env
*.db
*.db-journal
*.sqlite
*.log
.env
.env.local

# docs/results/*.json are needed at build time to seed the baked SQLite database
